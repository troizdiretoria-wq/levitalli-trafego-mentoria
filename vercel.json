{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": "{styles.css,script.js,aula-01-mentoria-trafego.pdf,index.html,aula-02.html,aula-2.html,public/**}"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/health",
      "dest": "/server.js"
    },
    {
      "src": "/aula-02",
      "dest": "/aula-02.html"
    },
    {
      "src": "/aula-2",
      "dest": "/aula-02.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
